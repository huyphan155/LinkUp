{
    "manifest_version": 3,
    "name": "LinkUp",
    "version": "2.0.0",
    "description": "Capture Chrome tabs as LinkUp workspace.",
    "permissions": [
      "tabs",
      "downloads",
      "storage"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "48": "icons/icon48.png"
      }
    }
  }
